# 复制为.env，文件权限设为600；不提交、不上传真实密钥。
APP_RELEASE=server-prep
SITE_ADDRESS=photos.example.com
PUBLIC_ORIGIN=https://photos.example.com
BIND_ADDRESS=0.0.0.0
HTTP_PORT=80
HTTPS_PORT=443

# AI默认关闭。账户模式只需服务器密钥；旧共享口令模式还需独立访问口令。
AI_ENABLED=false
ADMIN_ENABLED=true
# 账户模式默认关闭旧共享口令，便于按用户统计和限额。
AI_ALLOW_SHARED_TOKEN=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_ACCESS_TOKEN=
AI_DAILY_LIMIT=50
AI_PER_MINUTE=6
AI_CONCURRENCY=2
AI_TIMEOUT_MS=45000
AI_MAX_TOKENS=1800
