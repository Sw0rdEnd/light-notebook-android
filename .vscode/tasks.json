{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "启动光影练习册预览",
      "type": "shell",
      "command": "npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "owner": "light-journal",
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^> .* dev$",
          "endsPattern": "Light Journal preview ready:.*"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "运行自动测试",
      "type": "shell",
      "command": "npm test",
      "problemMatcher": []
    }
  ]
}
