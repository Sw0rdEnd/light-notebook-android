{
  "name": "light-notebook-android",
  "version": "0.2.8",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node scripts/build-server-web.mjs && node --test tests/*.test.mjs",
    "dev": "node scripts/dev-server.mjs",
    "start": "node scripts/dev-server.mjs",
    "preview": "node scripts/dev-server.mjs",
    "test:browser": "playwright test",
    "build:web": "node scripts/build-server-web.mjs",
    "start:server": "node server/index.mjs",
    "test:server": "node scripts/build-server-web.mjs && node --test tests/server*.test.mjs tests/ai-http.test.mjs",
    "test:admin": "node scripts/build-server-web.mjs && node --test tests/admin-server.test.mjs",
    "test:admin:browser": "node scripts/build-server-web.mjs && playwright test -c playwright.admin.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "fake-indexeddb": "6.2.6",
    "happy-dom": "21.0.3",
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=20"
  }
}
